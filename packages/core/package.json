{
  "name": "@cvd-policy/core",
  "version": "0.3.0",
  "description": "Reference implementation of the CVD Policy Format: validation, generation, evaluation, explanation.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
