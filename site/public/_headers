# Netlify and Cloudflare Pages syntax.
#
# ops/Caddyfile carries the same rules for a plain server. The two cannot be
# derived from one another, so a change here has to be made there as well.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: interest-cohort=(), geolocation=(), camera=(), microphone=()
  Cross-Origin-Opener-Policy: same-origin

# The policy page keeps its stylesheet inline, which `style-src 'self'` forbids.
# Narrower, not looser: it has no scripts and nothing to fetch, so only the
# inline style is allowed. Keep it separate from the rule above.
/security/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# The concrete URI below belongs to this site; V1 defines no default JSON path.
/cvd-policy.json
  Content-Type: application/cvd-policy+json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# Every published version and the report profiles, not just one of them: a
# rule naming a single file went stale the moment 0.2 shipped.
/schema/*
  Content-Type: application/schema+json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# Hashed assets never change under the same name; everything else may.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/.well-known/*
  Content-Type: text/plain
  Cache-Control: public, max-age=3600

/examples/*
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
